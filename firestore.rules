rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.uid == 'kjk86LonpVfk83NfpajQrhGxvOv1'; }
  function staff() { return admin() || (request.auth != null && request.auth.token.email_verified == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'); }
  match /users/{uid} { allow read: if admin() || (request.auth != null && request.auth.uid == uid); }
  match /students/{id} { allow read: if staff(); }
  match /payments/{id} { allow read: if staff(); }
  match /receipts/{id} { allow read: if staff(); }
  match /settings/{id} { allow read: if staff(); }
  match /audit/{id} { allow read: if admin(); }
  match /{document=**} { allow write: if false; }
 }
}
